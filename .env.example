# Copy this file to .env.local for local development.
# Never put real secrets or keys in this file.
# Required for the app to connect to Supabase:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: if you want to override the default redirect URL for auth flows.
# VITE_SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173
